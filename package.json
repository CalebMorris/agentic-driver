{
  "name": "agentic-driver",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "server",
    "mcp"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-mcp-sdk.js",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w server",
    "test:e2e": "npm run test:e2e -w server",
    "install:e2e": "npm run install:e2e -w server",
    "install:mcp": "claude mcp remove agentic-driver -s local 2>/dev/null || true && claude mcp remove agentic-driver -s user 2>/dev/null || true && claude mcp add agentic-driver -s user -- node \"$(pwd)/mcp/dist/index.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
