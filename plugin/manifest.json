{
  "manifest_version": 3,
  "name": "Agentic Driver",
  "version": "0.1.1",
  "description": "Connects to a local WebSocket server to allow AI agents to drive the browser.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agentic Driver"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
